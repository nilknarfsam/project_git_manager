{
  "name": "projectgit-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Electron shell for Project Git Manager (calls projectgit CLI)",
  "main": "main.js",
  "scripts": {
    "build": "vite build",
    "dev": "concurrently -k \"vite\" \"wait-on tcp:127.0.0.1:5173 && cross-env ELECTRON_DEV=1 electron .\"",
    "start": "electron ."
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cross-env": "^7.0.3",
    "electron": "^33.4.1",
    "typescript": "~5.6.3",
    "vite": "^6.0.5",
    "wait-on": "^8.0.1"
  }
}
